<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent template — the-dudes daemon (macOS, user-level).

  Placeholders (install-launchagent.sh):
    __LABEL__           com.the-dudes.daemon  |  com.the-dudes.daemon.<profile>
    __BASH__            path absoluto de bash
    __RUN_DAEMON__      path absoluto de run-daemon.sh (no home do perfil)
    __ENV_FILE__        daemon.env do perfil
    __LOG_FILE__        log do daemon (rotação no launcher)
    __TD_DIR__          home do perfil (~/.the-dudes ou ~/.the-dudes-<profile>)
    __HOME__            $HOME do usuário macOS (não o home do perfil)
    __PATH__            PATH com node
    __NODE__            path absoluto de node
    __DAEMON_BIN__      $TD_DIR/daemon.cjs
    __DAEMON_KEY__      $TD_DIR/daemon-key.pem
    __PROJECT_KEYS__    $TD_DIR/project-keys.json
    __DAEMON_CONFIG__   $TD_DIR/daemon-config.json
    __STDOUT__ / __STDERR__  logs launchd do wrapper

  Isolamento multi-conta (T-029): cada perfil tem TD_DIR próprio → binário,
  chave E2EE, project-keys e log separados. Self-update (dirname(selfPath))
  não colide entre perfis.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__BASH__</string>
    <string>__RUN_DAEMON__</string>
    <string>__ENV_FILE__</string>
    <string>__LOG_FILE__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__TD_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>THE_DUDES_NODE</key>
    <string>__NODE__</string>
    <key>THE_DUDES_LAUNCHER</key>
    <string>1</string>
    <key>THE_DUDES_DAEMON_BIN</key>
    <string>__DAEMON_BIN__</string>
    <key>THE_DUDES_DAEMON_KEY_PATH</key>
    <string>__DAEMON_KEY__</string>
    <key>THE_DUDES_PROJECT_KEYS_PATH</key>
    <string>__PROJECT_KEYS__</string>
    <key>THE_DUDES_DAEMON_CONFIG</key>
    <string>__DAEMON_CONFIG__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>__STDOUT__</string>
  <key>StandardErrorPath</key>
  <string>__STDERR__</string>
</dict>
</plist>
